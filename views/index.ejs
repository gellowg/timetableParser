<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Timetable App</title>
    <style>
        body {
            font-family: "Times New Roman";
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /*.container {*/
        /*    background-color: #fff;*/
        /*    padding: 2rem;*/
        /*    border-radius: 10px;*/
        /*    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);*/
        /*    width: 300px;*/
        /*    text-align: center;*/
        /*}*/

        h1 {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            text-align: left;
        }

        input, select {
            width: 100%;
            padding: 0.5rem;
            margin-bottom: 1rem;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
            font-size: 1rem;
            font-family: "Times New Roman";
        }

        button {
            width: 100%;
            padding: 0.7rem;
            background-color: grey;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
        }

        button:hover {
            background-color: darkgray;
        }

        p {
            font-size: 0.9rem;
        }

        #error {
            color: red;
        }

        #success {
            color: green;
        }

        .loading {
            display: none;
            text-align: center;
            margin: 20px 0;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 2s linear infinite;
            margin: 0 auto 10px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .progress-container {
            display: none;
            width: 100%;
            background-color: #f0f0f0;
            border-radius: 5px;
            margin: 10px 0;
        }

        .progress-bar {
            height: 20px;
            background-color: #4CAF50;
            border-radius: 5px;
            width: 0%;
            transition: width 0.3s ease;
        }

        .tooltip {
            position: relative;
            display: inline-block;
            cursor: help;
            margin-left: 5px;
            color: #666;
            font-weight: bold;
        }

        .tooltip .tooltiptext {
            visibility: hidden;
            width: 250px;
            background-color: #333;
            color: #fff;
            text-align: left;
            border-radius: 6px;
            padding: 12px;
            position: absolute;
            z-index: 1000;
            bottom: 125%;
            left: 50%;
            margin-left: -125px;
            opacity: 0;
            transition: opacity 0.3s;
            font-size: 12px;
            line-height: 1.4;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
            white-space: normal;
        }

        .tooltip .tooltiptext::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #333 transparent transparent transparent;
        }

        .tooltip:hover .tooltiptext {
            visibility: visible;
            opacity: 1;
        }

        .success-animation {
            animation: successPulse 0.6s ease-in-out;
        }

        @keyframes successPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .error-message {
            background-color: #ffebee;
            border: 1px solid #f44336;
            color: #c62828;
            padding: 10px;
            border-radius: 5px;
            margin: 10px 0;
        }

        .success-message {
            background-color: #e8f5e8;
            border: 1px solid #4caf50;
            color: #2e7d32;
            padding: 10px;
            border-radius: 5px;
            margin: 10px 0;
        }


        .academic-year-info {
            background-color: #e3f2fd;
            border: 1px solid #2196f3;
            color: #0d47a1;
            padding: 8px;
            border-radius: 5px;
            margin: 10px 0;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Student Timetable Downloader</h1>
        <form>
            <label for="student_id">Student ID
            </label>
            <input id="student_id" placeholder="Enter Student ID">
            
            <label for="bearer">Bearer Token
            </label>
            <input id="bearer" placeholder="Enter Bearer Token">
            
            <!-- Hidden date inputs for automatic date range -->
            <input type="hidden" id="start_date">
            <input type="hidden" id="end_date">
            
            <!-- Academic Year Info -->
            <div id="academicYearInfo" class="academic-year-info">
                <strong>Academic Year:</strong> <span id="academicYearDisplay">Loading...</span><br>
                <strong>Date Range:</strong> <span id="dateRangeDisplay">Loading...</span>
            </div>
            
            <!-- Test Connection Button -->
            <button id="testConnection" type="button" style="background-color: #ff9800; margin-bottom: 10px;">Test Connection</button>
            
            <button id="downloadCalendar" type="button">Download Calendar</button>
            
            <!-- Loading Spinner -->
            <div id="loading" class="loading">
                <div class="spinner"></div>
                <p>Fetching your timetable...</p>
            </div>
            
            <!-- Progress Bar -->
            <div id="progressContainer" class="progress-container">
                <div id="progressBar" class="progress-bar"></div>
                <p id="progressText">Processing...</p>
            </div>
            
        </form>
        
        <!-- Error and Success Messages -->
        <div id="error" class="error-message" style="display: none;"></div>
        <div id="success" class="success-message" style="display: none;"></div>
    </div>
    <script src="app.js"></script>
</body>
</html>